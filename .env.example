# FlowHub 환경 변수 샘플
# 사용법: cp .env.example .env 후 값 수정

# ── 공통 ────────────────────────────────────────
NODE_ENV=development

# ── 네트워크/포트 ───────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_PORT=3000
BACKEND_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── PostgreSQL ──────────────────────────────────
POSTGRES_USER=flowhub
POSTGRES_PASSWORD=flowhub_secret
POSTGRES_DB=flowhub

# ── Redis ───────────────────────────────────────
REDIS_PASSWORD=redis_secret

# ── Backend (Auth) ───────────────────────────────
JWT_SECRET=please_change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:9090,http://localhost:3100,http://localhost:3000

# ── Frontend (Next.js public) ───────────────────
NEXT_PUBLIC_API_BASE_URL=/api
# 소켓 서버 주소 (비워두면 window.location.origin 사용 — nginx :9090 경유 시 동일 출처로 동작)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4100

# ── 외부 연동 (선택) ───────────────────────────
GITHUB_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OPENAI_API_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
